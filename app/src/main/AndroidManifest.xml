<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Offline resilience (v0.7): observe connectivity to fall back to a cached-only
         view and to block plays of undownloaded tracks with no network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Background playback (v0.4). WAKE_LOCK backs ExoPlayer's WAKE_MODE_NETWORK,
         which keeps streaming alive with the screen off. POST_NOTIFICATIONS is
         requested at runtime on Android 13+; without it playback still works, but
         the media controls in the shade and on the lock screen do not appear. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DriveMP3">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- exported: the session has to be reachable by the system's media controls,
             Bluetooth and headset media buttons, and Assistant. The intent-filter
             action is how Media3 resolves the SessionToken.

             ExportedService is suppressed rather than fixed: guarding this with a
             permission is what the lint check wants, but it would lock out exactly the
             system components the session exists to serve. Media3 prescribes an
             unguarded exported service, and MediaSession vets callers itself through
             MediaSession.Callback.onConnect. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
